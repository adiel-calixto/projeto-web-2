# Servidor / Mongo
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/psw2

# Auth
JWT_SECRET=troque-por-uma-string-aleatoria-com-pelo-menos-32-bytes
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24

# CORS: origens do front-end autorizadas a chamar a API (obrigatório).
# Lista separada por vírgula, origem exata (esquema + host + porta, sem barra final).
# Sem "*". Para testar local, use a origem do seu front (ex.: Vite em 5173).
CORS_ORIGINS=http://localhost:5173

# URL pública usada para montar o link do e-mail
APP_BASE_URL=http://localhost:3000

# SMTP (exemplo Mailtrap/Ethereal em dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Catálogo de jogos <nao-responda@exemplo.com>"

# S3
AWS_REGION=sa-east-1
S3_BUCKET=psw2-capas-dev
# Só em desenvolvimento local. Em produção na AWS, use IAM Role e deixe vazio.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Base das URLs públicas das capas, sem barra final.
# Sem CloudFront: https://<bucket>.s3.<região>.amazonaws.com
# Com CloudFront: https://dxxxxxxxx.cloudfront.net (ou seu domínio)
S3_PUBLIC_BASE_URL=https://psw2-capas-dev.s3.sa-east-1.amazonaws.com
# Opcional para MinIO/LocalStack. Em produção na AWS, deixe vazio.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
